---
import Base from '../layouts/Base.astro';
import { loadData } from '../lib/data';
import { TECHS, PRODUCT_CATEGORIES } from '../data/schema';
import { materialxNodes, releases, usdSchemas } from '../data/generated';
import { withBase } from '../lib/url';
import { LEVEL_LABEL, LEVEL_ORDER, TECH_LABEL } from '../lib/view';

const { products, projects, capabilities, events } = await loadData();

// ── generated-data facts (Phase 1) ──
const usdFirst = usdSchemas.history[0];
const usdLast = usdSchemas.history.at(-1)!;
const usdReleases = releases.usd.releases;
const usdMajors = usdReleases.filter((r) => r.kind === 'major');
const mtlxLast = materialxNodes.history.at(-1)!;
const mtlxFirst = materialxNodes.history[0];
const mtlxLiveNodes = materialxNodes.nodes.filter((n) => !n.removedIn);
const coverage = materialxNodes.targets
  .filter((t) => t.id in mtlxLast.supported)
  .map((t) => ({ ...t, pct: Math.round((100 * mtlxLast.supported[t.id]) / mtlxLast.nodedefs) }));
const fmt = new Intl.NumberFormat('en');
const capabilityById = new Map(capabilities.map((c) => [c.id, c]));

const supportCount = products.reduce((n, p) => n + p.support.length, 0);
const versionLagReleases = products.reduce((n, p) => n + p.releases.filter((r) => r.usd || r.materialx).length, 0);
const sourceUrls = new Set([
  ...products.flatMap((p) => [...p.support, ...p.releases].flatMap((r) => r.sources.map((s) => s.url))),
  ...projects.flatMap((p) => p.sources.map((s) => s.url)),
  ...events.flatMap((e) => e.sources.map((s) => s.url)),
]);

const taxonomy = TECHS.map((tech) => {
  const caps = capabilities.filter((c) => c.tech === tech);
  const groups = [...new Set(caps.map((c) => c.group))].map((group) => ({
    group,
    caps: caps.filter((c) => c.group === group),
  }));
  return { tech, label: TECH_LABEL[tech], count: caps.length, groups };
});

const categoryLabel: Record<string, string> = {
  dcc: 'DCCs',
  renderer: 'Renderers',
  'game-engine': 'Game engines',
  viewer: 'Viewers',
  texturing: 'Texturing',
  lookdev: 'Look development',
  compositing: 'Compositing',
  layout: 'Layout',
  pipeline: 'Pipeline',
  cad: 'CAD',
  aec: 'AEC',
  'xr-web': 'XR & web',
  platform: 'Platforms',
  library: 'Libraries',
};
const byCategory = PRODUCT_CATEGORIES.map((cat) => ({
  cat,
  label: categoryLabel[cat] ?? cat,
  items: products.filter((p) => p.categories[0] === cat),
})).filter((g) => g.items.length > 0);

const recentEvents = [...events].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 6);
const topProjects = [...projects]
  .sort((a, b) => (b.stats?.stars ?? 0) - (a.stats?.stars ?? 0))
  .slice(0, 6);

const stats = [
  { value: products.length, label: 'products tracked', href: withBase('matrix/') },
  { value: capabilities.length, label: 'capabilities per product', href: withBase('matrix/') },
  { value: supportCount, label: 'sourced support records', href: withBase('matrix/') },
  { value: sourceUrls.size, label: 'sources cited', href: withBase('review/') },
  { value: projects.length, label: 'open-source projects', href: withBase('ecosystem/') },
  { value: events.length, label: 'timeline milestones', href: withBase('timeline/') },
];

const views = [
  {
    href: withBase('matrix/'),
    title: 'Support matrix',
    desc: `${products.length} products × ${capabilities.length} capabilities with filterable rows, columns and source inspection.`,
  },
  {
    href: withBase('versions/'),
    title: 'Version lag',
    desc: `How many months each product release trails the OpenUSD or MaterialX version it bundles, across ${versionLagReleases} releases.`,
  },
  {
    href: withBase('timeline/'),
    title: 'Adoption timeline',
    desc: 'Spec milestones, upstream releases and product adoption from 2012 to today.',
  },
  {
    href: withBase('ecosystem/'),
    title: 'Open-source ecosystem',
    desc: `${projects.length} libraries, Hydra delegates, DCC plugins and converters with weekly GitHub telemetry.`,
  },
  {
    href: withBase('schemas/'),
    title: 'Schemas & nodes',
    desc: `Every OpenUSD schema (${usdLast.schemas}) and MaterialX node (${mtlxLiveNodes.length}), tracked across releases.`,
  },
  {
    href: withBase('nodes/'),
    title: 'MaterialX node table',
    desc: `All ${mtlxLiveNodes.length} MaterialX nodes as a periodic table, coloured by what each of MaterialX's own code generators supports.`,
  },
];
---

<Base>
  <section class="hero container">
    <p class="eyebrow">OpenUSD {usdSchemas.latest} · MaterialX {materialxNodes.latest} · Sourced &amp; weekly-refreshed</p>
    <h1>Who supports <span class="usd">OpenUSD</span> and <span class="mtlx">MaterialX</span>, how well, and since when?</h1>
    <p class="lede muted">
      A living, sourced map of USD and MaterialX support across film, VFX, games, AEC, product design and the web,
      covering DCCs, renderers, engines and the open-source tools around them.
    </p>
    <ul class="stats" role="list">
      {
        stats.map((s) => (
          <li>
            <a href={s.href}>
              <strong>{fmt.format(s.value)}</strong>
              <span class="muted">{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="view-cards">
      {
        views.map((v) => (
          <a class="view-card" href={v.href}>
            <span class="view-title">
              {v.title} <span aria-hidden="true">→</span>
            </span>
            <span class="muted">{v.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container">
    <div class="sec-head">
      <div>
        <h2>Products tracked ({products.length})</h2>
        <p class="muted">
          Select any product for its full capability breakdown, release history, known issues and cited sources — or
          compare them side by side in the <a href={withBase('matrix/')}>support matrix</a>.
        </p>
      </div>
      <a class="cta-link" href={withBase('matrix/')}>Open interactive matrix →</a>
    </div>
    {
      byCategory.map((g) => (
        <div class="category">
          <h3>{g.label}</h3>
          <div class="products">
            {g.items.map((p) => {
              const latestUsd = p.releases.find((r) => r.usd)?.usd;
              const latestMtlx = p.releases.find((r) => r.materialx)?.materialx;
              const flags = p.support.filter((s) => s.review || s.confidence === 'low').length;
              return (
                <article class="product">
                  <header>
                    <div>
                      <a class="prod-link" href={withBase(`products/${p.id}/`)}>{p.name}</a>
                      <span class="muted vendor">{p.vendor}</span>
                    </div>
                    <div class="badges">
                      {latestUsd && <span class="ver usd" title="Latest bundled OpenUSD">USD {latestUsd}</span>}
                      {latestMtlx && <span class="ver materialx" title="Latest bundled MaterialX">MtlX {latestMtlx}</span>}
                      <span class="tier">T{p.tier}</span>
                    </div>
                  </header>
                  {p.support.length === 0 ? (
                    <p class="muted pending">Research pending</p>
                  ) : (
                    <div class="bars">
                      {TECHS.map((tech) => {
                        const totalCaps = capabilities.filter((c) => c.tech === tech).length;
                        const recs = p.support.filter((s) => capabilityById.get(s.capability)?.tech === tech);
                        const segs = LEVEL_ORDER.map((lv) => ({
                          lv,
                          n: recs.filter((s) => s.level === lv).length,
                        })).filter((x) => x.n > 0);
                        const active = recs.filter((s) =>
                          ['native', 'plugin', 'partial', 'experimental'].includes(s.level),
                        ).length;
                        return (
                          <div class="bar-row">
                            <span class={`tech-name ${tech}`}>{TECH_LABEL[tech]}</span>
                            <div
                              class="mini-bar"
                              title={
                                segs.map((s) => `${s.n} ${LEVEL_LABEL[s.lv].toLowerCase()}`).join(', ') || 'No records'
                              }
                            >
                              {segs.map((s) => (
                                <span
                                  class={`seg lv-${s.lv}`}
                                  style={`width:${(100 * s.n) / totalCaps}%`}
                                />
                              ))}
                            </div>
                            <span class="bar-num muted">
                              {active}/{totalCaps}
                            </span>
                          </div>
                        );
                      })}
                      {flags > 0 && <p class="muted flag-note">⚑ {flags} flagged for review</p>}
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      ))
    }
  </section>

  <section class="container">
    <div class="sec-head">
      <div>
        <h2>What we track</h2>
        <p class="muted">
          "Supports USD" can mean anything from a basic importer to a native USD stage. Every product is scored on each
          of these {capabilities.length} capabilities separately.
        </p>
      </div>
    </div>
    <div class="taxonomy">
      {
        taxonomy.map((t) => (
          <article class={`tech-card ${t.tech}`}>
            <h3>
              {t.label} <span class="muted count">{t.count} capabilities</span>
            </h3>
            {t.groups.map((g) => (
              <div class="group">
                <h4>{g.group}</h4>
                <ul class="chips" role="list">
                  {g.caps.map((c) => (
                    <li title={c.description}>{c.label}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  <section class="container">
    <div class="sec-head">
      <div>
        <h2>Collected automatically from upstream</h2>
        <p class="muted">Read straight from the OpenUSD and MaterialX repositories and refreshed every week.</p>
      </div>
      <a class="cta-link" href={withBase('schemas/')}>Explore all schemas &amp; nodes →</a>
    </div>
    <div class="facts">
      <article class="fact-card usd">
        <h3>OpenUSD {usdSchemas.latest}</h3>
        <p class="big">{usdLast.schemas} <span>schemas</span></p>
        <p class="muted">
          {
            `${usdLast.concrete} prim types and ${usdLast.api} API schemas across ${Object.keys(usdLast.byDomain).length} domains, ` +
              `up from ${usdFirst.schemas} schemas in ${usdFirst.version}. ` +
              `${usdReleases.length} releases since ${usdReleases[0].date.slice(0, 4)} (${usdMajors.length} scheduled).`
          }
        </p>
        <div class="fact-links">
          <a href={withBase('schemas/')}>Browse schemas →</a>
          <a href={withBase('data/usd-schemas.json')}>usd-schemas.json</a>
        </div>
      </article>
      <article class="fact-card materialx">
        <h3>MaterialX {materialxNodes.latest}</h3>
        <p class="big">{mtlxLiveNodes.length} <span>nodes</span></p>
        <p class="muted">
          {
            `${fmt.format(mtlxLast.nodedefs)} type variants, up from ${fmt.format(mtlxFirst.nodedefs)} in ${mtlxFirst.version}. ` +
              `Share supported by MaterialX's own code generators:`
          }
        </p>
        <ul class="coverage" role="list">
          {coverage.map((t) => (
            <li>
              <span>{t.label}</span>
              <strong>{t.pct}%</strong>
            </li>
          ))}
        </ul>
        <div class="fact-links">
          <a href={withBase('schemas/')}>Browse nodes →</a>
          <a href={withBase('data/materialx-nodes.json')}>materialx-nodes.json</a>
        </div>
      </article>
    </div>
  </section>

  <section class="container two-col">
    <div>
      <div class="sec-head">
        <h2>Recent milestones</h2>
        <a class="cta-link" href={withBase('timeline/')}>Full timeline ({events.length}) →</a>
      </div>
      <ol class="milestones" role="list">
        {
          recentEvents.map((e) => (
            <li>
              <time class="mono muted">{e.date}</time>
              <div>
                <strong>{e.title}</strong>
                {e.description && <p class="muted">{e.description}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <div class="sec-head">
        <h2>Open-source ecosystem</h2>
        <a class="cta-link" href={withBase('ecosystem/')}>All {projects.length} projects →</a>
      </div>
      <div class="projects">
        {
          topProjects.map((p) => (
            <article class="project">
              <header>
                <a href={p.stats?.url ?? p.url} rel="noopener">
                  {p.name}
                </a>
                {p.stats && <span class="stars" title="GitHub stars">★ {fmt.format(p.stats.stars)}</span>}
              </header>
              <p class="muted">{p.description}</p>
              <p class="meta">
                <span class="kind">{p.kind}</span>
                {p.tech.map((t) => (
                  <span class={`tech ${t}`}>{t === 'usd' ? 'USD' : 'MaterialX'}</span>
                ))}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(36px, 6vw, 76px);
    padding-bottom: 24px;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 18px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.3rem);
    max-width: 21ch;
    margin: 0 0 14px;
  }
  .usd {
    color: var(--usd);
  }
  .mtlx {
    color: var(--mtlx);
  }
  .lede {
    font-size: 1.12rem;
    max-width: 62ch;
    margin: 0 0 28px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    padding: 0;
    margin: 0 0 18px;
    list-style: none;
  }
  .stats li a {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.12s;
  }
  .stats li a:hover {
    border-color: var(--accent);
  }
  .stats strong {
    font-size: 1.85rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats span {
    font-size: 0.85rem;
    margin-top: 6px;
  }

  .view-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 10px;
  }
  .view-card {
    background: color-mix(in srgb, var(--surface) 80%, var(--accent) 6%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.12s, transform 0.12s;
  }
  .view-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .view-title {
    font-weight: 650;
    font-size: 0.98rem;
    display: flex;
    justify-content: space-between;
  }
  .view-card .muted {
    font-size: 0.84rem;
    line-height: 1.45;
  }

  section + section {
    margin-top: 56px;
  }
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .sec-head h2 {
    margin: 0;
  }
  .sec-head p {
    margin: 4px 0 0;
    max-width: 68ch;
  }
  .cta-link {
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .category h3 {
    font-size: 0.95rem;
    margin: 22px 0 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 10px;
  }
  .product {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .product header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }
  .prod-link {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
    margin-right: 6px;
  }
  .prod-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .vendor {
    font-size: 0.8rem;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .ver {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .ver.usd {
    border-color: color-mix(in srgb, var(--usd) 50%, var(--border));
    color: var(--usd);
  }
  .ver.materialx {
    border-color: color-mix(in srgb, var(--mtlx) 50%, var(--border));
    color: var(--mtlx);
  }
  .tier {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .pending {
    font-size: 0.85rem;
    margin: 0;
  }
  .bars {
    display: grid;
    gap: 6px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 68px 1fr 42px;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
  }
  .tech-name {
    font-weight: 600;
  }
  .tech-name.usd {
    color: var(--usd);
  }
  .tech-name.materialx {
    color: var(--mtlx);
  }
  .mini-bar {
    height: 8px;
    background: color-mix(in srgb, var(--border) 60%, transparent);
    border-radius: 999px;
    overflow: hidden;
    display: flex;
  }
  .mini-bar .seg {
    height: 100%;
    background: var(--lv-pattern, none), var(--lv);
  }
  .bar-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .flag-note {
    font-size: 0.74rem;
    margin: 2px 0 0;
  }

  .taxonomy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }
  .tech-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--tech);
    border-radius: var(--radius);
    padding: 20px;
  }
  .tech-card.usd {
    --tech: var(--usd);
  }
  .tech-card.materialx {
    --tech: var(--mtlx);
  }
  .tech-card h3 {
    margin: 0 0 12px;
  }
  .count {
    font-weight: 400;
    font-size: 0.88rem;
  }
  .group h4 {
    margin: 14px 0 6px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .chips li {
    font-size: 0.82rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tech) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--tech) 35%, transparent);
    cursor: help;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 16px;
  }
  .fact-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--tech);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .fact-card.usd {
    --tech: var(--usd);
  }
  .fact-card.materialx {
    --tech: var(--mtlx);
  }
  .fact-card h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-muted);
  }
  .big {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin: 8px 0;
    font-variant-numeric: tabular-nums;
  }
  .big span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .fact-links {
    margin-top: auto;
    padding-top: 12px;
    display: flex;
    gap: 16px;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 6px 16px;
    padding: 0;
    margin: 0 0 8px;
    list-style: none;
    font-size: 0.88rem;
  }
  .coverage li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed var(--border);
  }
  .coverage strong {
    font-variant-numeric: tabular-nums;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 28px;
  }
  .milestones {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .milestones li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 10px;
    align-items: baseline;
    font-size: 0.88rem;
  }
  .milestones time {
    font-size: 0.78rem;
  }
  .milestones p {
    margin: 4px 0 0;
    font-size: 0.82rem;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 10px;
  }
  .project {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
  }
  .project header {
    display: flex;
