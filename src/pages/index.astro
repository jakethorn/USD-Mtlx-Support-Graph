---
/**
 * Phase 0 placeholder: proves data → schema → page end to end.
 * Replaced by the real landing view in Phase 4.
 */
import Base from '../layouts/Base.astro';
import { loadData } from '../lib/data';
import { TECHS, PRODUCT_CATEGORIES, SUPPORT_LEVELS } from '../data/schema';
import { materialxNodes, releases, usdSchemas } from '../data/generated';
import { withBase } from '../lib/url';

const { products, projects, capabilities, events } = await loadData();

// ── generated-data facts (Phase 1) ──
const usdFirst = usdSchemas.history[0];
const usdLast = usdSchemas.history.at(-1)!;
const usdReleases = releases.usd.releases;
const usdMajors = usdReleases.filter((r) => r.kind === 'major');
const mtlxLast = materialxNodes.history.at(-1)!;
const mtlxFirst = materialxNodes.history[0];
const mtlxLiveNodes = materialxNodes.nodes.filter((n) => !n.removedIn);
const coverage = materialxNodes.targets
  .filter((t) => t.id in mtlxLast.supported)
  .map((t) => ({ ...t, pct: Math.round((100 * mtlxLast.supported[t.id]) / mtlxLast.nodedefs) }));
const fmt = new Intl.NumberFormat('en');
const capabilityById = new Map(capabilities.map((c) => [c.id, c]));

const supportCount = products.reduce((n, p) => n + p.support.length, 0);
const sourceUrls = new Set([
  ...products.flatMap((p) => [...p.support, ...p.releases].flatMap((r) => r.sources.map((s) => s.url))),
  ...projects.flatMap((p) => p.sources.map((s) => s.url)),
  ...events.flatMap((e) => e.sources.map((s) => s.url)),
]);

const techLabel: Record<(typeof TECHS)[number], string> = { usd: 'OpenUSD', materialx: 'MaterialX' };
const taxonomy = TECHS.map((tech) => {
  const caps = capabilities.filter((c) => c.tech === tech);
  const groups = [...new Set(caps.map((c) => c.group))].map((group) => ({
    group,
    caps: caps.filter((c) => c.group === group),
  }));
  return { tech, label: techLabel[tech], count: caps.length, groups };
});

const categoryLabel: Record<string, string> = {
  dcc: 'DCCs',
  renderer: 'Renderers',
  'game-engine': 'Game engines',
  viewer: 'Viewers',
  texturing: 'Texturing',
  lookdev: 'Look development',
  compositing: 'Compositing',
  layout: 'Layout',
  pipeline: 'Pipeline',
  cad: 'CAD',
  aec: 'AEC',
  'xr-web': 'XR & web',
  platform: 'Platforms',
  library: 'Libraries',
};
const byCategory = PRODUCT_CATEGORIES.map((cat) => ({
  cat,
  label: categoryLabel[cat] ?? cat,
  items: products.filter((p) => p.categories[0] === cat),
})).filter((g) => g.items.length > 0);

const stats = [
  { value: products.length, label: 'products tracked' },
  { value: projects.length, label: 'open-source projects' },
  { value: events.length, label: 'timeline milestones' },
  { value: capabilities.length, label: 'capabilities per product' },
  { value: supportCount, label: 'sourced support records' },
  { value: sourceUrls.size, label: 'sources cited' },
];
---

<Base>
  <section class="hero container">
    <p class="eyebrow">Early preview · data collection in progress</p>
    <h1>Who supports <span class="usd">OpenUSD</span> and <span class="mtlx">MaterialX</span>, how well, and since when?</h1>
    <p class="lede muted">
      A living, sourced map of USD and MaterialX support across film, VFX, games, AEC, product design and the web,
      covering DCCs, renderers, engines and the open-source tools around them.
    </p>
    <ul class="stats" role="list">
      {
        stats.map((s) => (
          <li>
            <strong>{s.value}</strong>
            <span class="muted">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container">
    <h2>What we track</h2>
    <p class="muted">
      "Supports USD" can mean anything from a basic importer to a native USD stage. So every product is scored on each
      of these capabilities separately.
    </p>
    <div class="taxonomy">
      {
        taxonomy.map((t) => (
          <article class={`tech-card ${t.tech}`}>
            <h3>
              {t.label} <span class="muted count">{t.count}</span>
            </h3>
            {t.groups.map((g) => (
              <div class="group">
                <h4>{g.group}</h4>
                <ul class="chips" role="list">
                  {g.caps.map((c) => (
                    <li title={c.description}>{c.label}</li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))
      }
    </div>
  </section>

  <section class="container">
    <h2>Collected automatically</h2>
    <p class="muted">Read straight from the upstream repositories and refreshed every week.</p>
    <div class="facts">
      <article class="fact-card usd">
        <h3>OpenUSD {usdSchemas.latest}</h3>
        <p class="big">{usdLast.schemas} <span>schemas</span></p>
        <p class="muted">
          {
            `${usdLast.concrete} prim types and ${usdLast.api} API schemas across ${Object.keys(usdLast.byDomain).length} domains, ` +
              `up from ${usdFirst.schemas} schemas in ${usdFirst.version}. ` +
              `${usdReleases.length} releases since ${usdReleases[0].date.slice(0, 4)} (${usdMajors.length} scheduled).`
          }
        </p>
        <a href={withBase('data/usd-schemas.json')}>usd-schemas.json</a>
      </article>
      <article class="fact-card materialx">
        <h3>MaterialX {materialxNodes.latest}</h3>
        <p class="big">{mtlxLiveNodes.length} <span>nodes</span></p>
        <p class="muted">
          {
            `${fmt.format(mtlxLast.nodedefs)} type variants, up from ${fmt.format(mtlxFirst.nodedefs)} in ${mtlxFirst.version}. ` +
              `Share supported by MaterialX's own code generators:`
          }
        </p>
        <ul class="coverage" role="list">
          {coverage.map((t) => (
            <li>
              <span>{t.label}</span>
              <strong>{t.pct}%</strong>
            </li>
          ))}
        </ul>
        <a href={withBase('data/materialx-nodes.json')}>materialx-nodes.json</a>
      </article>
    </div>
  </section>

  <section class="container">
    <h2>Open-source ecosystem</h2>
    <div class="projects">
      {
        projects.map((p) => (
          <article class="project">
            <header>
              <a href={p.stats?.url ?? p.url} rel="noopener">
                {p.name}
              </a>
              {p.stats && <span class="stars" title="GitHub stars">★ {fmt.format(p.stats.stars)}</span>}
            </header>
            <p class="muted">{p.description}</p>
            <p class="meta">
              <span class="kind">{p.kind}</span>
              {p.tech.map((t) => (
                <span class={`tech ${t}`}>{t === 'usd' ? 'USD' : 'MaterialX'}</span>
              ))}
              {p.stats?.archived && <span class="archived">archived</span>}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container">
    <h2>Products so far</h2>
    <p class="muted">
      Open a product to see every record and its sources. Records with conflicting or indirect evidence are collected on
      the <a href={withBase('review/')}>Needs review</a> page.
    </p>
    {
      byCategory.map((g) => (
        <div class="category">
          <h3>{g.label}</h3>
          <div class="products">
            {g.items.map((p) => (
              <article class="product">
                <header>
                  <a href={withBase(`products/${p.id}/`)}>{p.name}</a>
                  <span class="muted vendor">{p.vendor}</span>
                </header>
                {p.support.length === 0 ? (
                  <p class="muted pending">Research pending</p>
                ) : (
                  <ul class="records" role="list">
                    {TECHS.map((tech) => {
                      const recs = p.support.filter((s) => capabilityById.get(s.capability)?.tech === tech);
                      const byLevel = SUPPORT_LEVELS.map((l) => [l, recs.filter((s) => s.level === l).length] as const).filter(([, n]) => n > 0);
                      return (
                        recs.length > 0 && (
                          <li>
                            <span class="tech-name">{techLabel[tech]}</span>
                            {byLevel.map(([l, n]) => (
                              <span class={`level level-${l}`} title={`${n} ${l}`}>
                                {n} {l}
                              </span>
                            ))}
                          </li>
                        )
                      );
                    })}
                    {p.support.some((s) => s.review || s.confidence === 'low') && (
                      <li class="muted flag-note">
                        {p.support.filter((s) => s.review || s.confidence === 'low').length} flagged for review
                      </li>
                    )}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(40px, 8vw, 96px);
    padding-bottom: 32px;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px 12px;
    margin: 0 0 20px;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    max-width: 20ch;
    margin: 0 0 16px;
  }
  .usd {
    color: var(--usd);
  }
  .mtlx {
    color: var(--mtlx);
  }
  .lede {
    font-size: 1.15rem;
    max-width: 60ch;
    margin: 0 0 32px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .stats li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
  }
  .stats strong {
    font-size: 2rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats span {
    font-size: 0.9rem;
    margin-top: 6px;
  }
  section + section {
    margin-top: 56px;
  }
  .taxonomy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 16px;
  }
  .tech-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--tech);
    border-radius: var(--radius);
    padding: 20px;
  }
  .tech-card.usd {
    --tech: var(--usd);
  }
  .tech-card.materialx {
    --tech: var(--mtlx);
  }
  .tech-card h3 {
    margin: 0 0 12px;
  }
  .count {
    font-weight: 400;
    font-size: 0.9rem;
  }
  .group h4 {
    margin: 14px 0 6px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .chips li {
    font-size: 0.85rem;
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tech) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--tech) 35%, transparent);
    cursor: help;
  }
  .category h3 {
    font-size: 1rem;
    margin: 24px 0 10px;
    color: var(--text-muted);
  }
  .products {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 12px;
  }
  .product {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
  }
  .product header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .product header a {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  .vendor {
    font-size: 0.85rem;
  }
  .pending {
    font-size: 0.9rem;
    margin: 8px 0 0;
  }
  .records {
    padding: 0;
    margin: 10px 0 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 0.9rem;
  }
  .records li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .level {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 1px 8px;
    border-radius: 4px;
    color: #fff;
    background: var(--level-color);
  }
  .level-native { --level-color: var(--level-native); }
  .level-plugin { --level-color: var(--level-plugin); }
  .level-partial { --level-color: var(--level-partial); }
  .level-experimental { --level-color: var(--level-experimental); }
  .level-planned { --level-color: var(--level-planned); }
  .level-deprecated { --level-color: var(--level-deprecated); }
  .level-none { --level-color: var(--level-none); }
  .tech-name {
    min-width: 76px;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .flag-note {
    font-size: 0.8rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 16px;
  }
  .fact-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--tech);
    border-radius: var(--radius);
    padding: 20px;
  }
  .fact-card.usd {
    --tech: var(--usd);
  }
  .fact-card.materialx {
    --tech: var(--mtlx);
  }
  .fact-card h3 {
    margin: 0;
    font-size: 1rem;
    color: var(--text-muted);
  }
  .big {
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.1;
    margin: 8px 0;
    font-variant-numeric: tabular-nums;
  }
  .big span {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .fact-card a {
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .coverage {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 6px 16px;
    padding: 0;
    margin: 0 0 14px;
    list-style: none;
    font-size: 0.9rem;
  }
  .coverage li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed var(--border);
  }
  .coverage strong {
    font-variant-numeric: tabular-nums;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .project {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
  }
  .project header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .project header a {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  .stars {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .project p {
    margin: 6px 0 0;
    font-size: 0.9rem;
  }
  .project .meta {
    margin-top: auto;
    padding-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.75rem;
  }
  .meta span {
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .meta .tech.usd {
    border-color: var(--usd);
  }
  .meta .tech.materialx {
    border-color: var(--mtlx);
  }
  .meta .archived {
    color: var(--level-none);
    border-color: var(--level-none);
  }
</style>
