---
/**
 * Every record flagged for human review (a `review:` note or low confidence), in one place.
 * This is the only part of the data the maintainer reviews by hand.
 */
import Base from '../layouts/Base.astro';
import LevelBadge from '../components/LevelBadge.astro';
import { loadData } from '../lib/data';
import { withBase } from '../lib/url';

const { products, capabilities, nodeSupport } = await loadData();
const capById = new Map(capabilities.map((c) => [c.id, c]));

type Selector = { libraries?: string[]; groups?: string[]; nodes?: string[]; nodedefs?: string[] };
const selectorText = (s: Selector) => {
  const names = [...(s.libraries ?? []), ...(s.groups ?? []), ...(s.nodes ?? []), ...(s.nodedefs ?? [])];
  return names.slice(0, 5).join(', ') + (names.length > 5 ? ` and ${names.length - 5} more` : '');
};

// Node-support records and exceptions: an exception is listed on its own only when it is flagged itself.
const nodeItems = nodeSupport.flatMap((ns) => {
  const product = products.find((p) => p.id === ns.product)!;
  const scopeText = (ids?: string[]) =>
    ids ? ` (${ids.map((id) => ns.scopes.find((s) => s.id === id)?.label ?? id).join(', ')})` : '';
  return ns.records.flatMap((r, i) => {
    const claims = ns.resolved.claims[i];
    const own = claims.record.flagged
      ? [{ product, what: `MaterialX nodes${scopeText(r.scopes)}: ${selectorText(r)}`, tech: 'materialx' as const, level: r.level as string | undefined, reason: r.review ?? 'Low confidence', notes: r.notes, sources: r.sources }]
      : [];
    const exceptions = r.except
      .map((e, j) => ({ e, c: claims.except[j] }))
      .filter(({ e }) => e.review || e.confidence === 'low')
      .map(({ e, c }) => ({
        product,
        what: `MaterialX nodes${scopeText(r.scopes)}: except ${selectorText(e)}`,
        tech: 'materialx' as const,
        level: e.level as string | undefined,
        reason: e.review ?? 'Low confidence',
        notes: e.notes,
        sources: c.sources,
      }));
    return [...own, ...exceptions];
  });
});

const items = products.flatMap((p) => [
  ...p.support
    .filter((s) => s.review || s.confidence === 'low')
    .map((s) => ({
      product: p,
      what: capById.get(s.capability)?.label ?? s.capability,
      tech: capById.get(s.capability)?.tech,
      level: s.level as string | undefined,
      reason: s.review ?? 'Low confidence',
      notes: s.notes,
      sources: s.sources,
    })),
  ...p.releases
    .filter((r) => r.review)
    .map((r) => ({ product: p, what: `Release ${r.version}`, tech: undefined, level: undefined, reason: r.review!, notes: r.notes, sources: r.sources })),
  ...p.issues
    .filter((i) => i.review)
    .map((i) => ({ product: p, what: `Issue: ${i.title}`, tech: undefined, level: undefined, reason: i.review!, notes: undefined, sources: [{ url: i.url, title: 'Issue' }] })),
  ...nodeItems.filter((n) => n.product.id === p.id),
]);
---

<Base title="Needs review">
  <div class="container page">
    <h1>Needs review <span class="muted">({items.length})</span></h1>
    <p class="muted">
      Records whose sources conflict, are ambiguous or are indirect. Everything else on the site stands on its cited
      sources.
    </p>
    {items.length === 0 && <p>Nothing flagged.</p>}
    <ul class="items" role="list">
      {
        items.map((i) => (
          <li>
            <div class="head">
              <a href={withBase(`products/${i.product.id}/`)}>
                <strong>{i.product.name}</strong>
              </a>
              <span>·</span>
              <span>{i.what}</span>
              {i.tech && <span class="muted">{i.tech === 'usd' ? 'OpenUSD' : 'MaterialX'}</span>}
              {i.level && <LevelBadge level={i.level} />}
            </div>
            <p class="reason">{i.reason}</p>
            {i.notes && <p class="muted">{i.notes}</p>}
            <p class="sources">
              {i.sources.map((s) => (
                <a href={s.url} rel="noopener">{s.title ?? new URL(s.url).hostname}</a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: 32px;
  }
  .items {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .items > li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--level-partial);
    border-radius: var(--radius);
    padding: 12px 14px;
    min-width: 0;
    /* Node-support flags quote long identifiers (ND_…, node lists) that must wrap on phones. */
    overflow-wrap: anywhere;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
  }
  .head a {
    color: var(--text);
  }
  p {
    margin: 6px 0 0;
    font-size: 0.92rem;
  }
  .reason {
    font-weight: 600;
  }
  .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 0.82rem;
  }
</style>
